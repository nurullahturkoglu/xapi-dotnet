<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Also required for IDE0005 (unused usings) to run during build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Nurullah Türkoğlu</Authors>
    <Copyright>Copyright (c) Nurullah Türkoğlu and contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nurullahturkoglu/xapi-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nurullahturkoglu/xapi-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Shared tags; each package adds its own with $(PackageTags);... -->
    <PackageTags>xapi;experience-api;tincan;elearning;ieee-9274</PackageTags>
    <PackageReleaseNotes>https://github.com/nurullahturkoglu/xapi-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Public half of eng/xapi-dotnet.snk, used for InternalsVisibleTo between signed assemblies -->
    <XapiPublicKey></XapiPublicKey>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

</Project>
