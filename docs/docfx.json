{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "output": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["*.md", "toc.yml", "adr/*.md", "adr/toc.yml", "api/*.yml"],
        "exclude": ["README.md"]
      }
    ],
    "resource": [
      {
        "files": ["icon.svg"],
        "src": "../eng",
        "dest": "images"
      }
    ],
    "overwrite": [
      {
        "files": ["api-notes/*.md"]
      }
    ],
    "output": "../artifacts/docs-site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "xapi-dotnet",
      "_appName": "xapi-dotnet",
      "_appLogoPath": "images/icon.svg",
      "_appFaviconPath": "images/icon.svg",
      "_lang": "en",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/nurullahturkoglu/xapi-dotnet",
        "branch": "main"
      }
    },
    "fileMetadata": {
      "_disableBreadcrumb": {
        "*.md": true
      }
    }
  }
}
