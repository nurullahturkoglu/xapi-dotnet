<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>Test</ProjectType>
    <!-- Set here, not in eng/Test.targets: .NET Framework picks the .exe extension before that file is imported -->
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- net481 exercises the netstandard2.0 build on a .NET Framework runtime -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net481</TargetFrameworks>
    <!--
      Microsoft.Extensions.TimeProvider.Testing ships a net462 build but warns on any .NET Framework target it was
      not tested with. It only drives timers in these tests.
    -->
    <SuppressTfmSupportBuildWarnings Condition="'$(TargetFramework)' == 'net481'">true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Xapi.Client.Outbox/Xapi.Client.Outbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- The hosted service only exists in the net10.0 build -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="DependencyInjection/**" />
  </ItemGroup>

  <!-- On .NET Framework, HttpClient lives in an assembly that is not referenced or imported by default -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- MeterListener helper shared by the metrics tests -->
    <Compile Include="../Shared/MetricRecorder.cs" Link="Shared/MetricRecorder.cs" />
  </ItemGroup>

</Project>
