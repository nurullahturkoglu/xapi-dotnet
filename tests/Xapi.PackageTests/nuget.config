<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the folder that `dotnet pack -o artifacts/packages` writes to as a source, and maps Xapi.* to it.
  NuGet merges this file with the repository root nuget.config. The more specific pattern wins,
  so Xapi.* packages can only come from the local folder and never from nuget.org.
-->
<configuration>
  <packageSources>
    <add key="xapi-local" value="../../artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="xapi-local">
      <package pattern="Xapi.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
