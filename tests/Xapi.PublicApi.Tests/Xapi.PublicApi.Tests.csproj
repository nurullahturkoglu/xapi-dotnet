<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>Test</ProjectType>
    <!-- Set here, not in eng/Test.targets: .NET Framework picks the .exe extension before that file is imported -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Xapi.Client/Xapi.Client.csproj" />
    <ProjectReference Include="../../src/Xapi.Core/Xapi.Core.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs/Xapi.Lrs.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs.Sqlite/Xapi.Lrs.Sqlite.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs.PostgreSql/Xapi.Lrs.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CallerFilePath is rewritten by PathMap in CI builds, so the snapshot folder is passed in as metadata instead -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ApiSnapshotDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/ApiSnapshots</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
