<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keeps the C# code in README.md, docs/ and the package READMEs (src/*/README.md) compiling: each marked code block
    there must match a snippet region in Snippets/ (see SnippetTests), and the regions are compiled here against the
    current API.
  -->

  <PropertyGroup>
    <ProjectType>Test</ProjectType>
    <!-- Set here, not in eng/Test.targets: .NET Framework picks the .exe extension before that file is imported -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Xapi.Client/Xapi.Client.csproj" />
    <ProjectReference Include="../../src/Xapi.Client.Outbox/Xapi.Client.Outbox.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs.Sqlite/Xapi.Lrs.Sqlite.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs.PostgreSql/Xapi.Lrs.PostgreSql.csproj" />
  </ItemGroup>

</Project>
