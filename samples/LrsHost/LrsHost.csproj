<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ProjectType>Sample</ProjectType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Strong-named because tests/Xapi.Lrs.Tests (signed) hosts this app with WebApplicationFactory -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../eng/xapi-dotnet.snk</AssemblyOriginatorKeyFile>
    <!-- The Web SDK warns when "dotnet pack xapi-dotnet.slnx" reaches a project that is not packable -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Xapi.Lrs.Sqlite/Xapi.Lrs.Sqlite.csproj" />
    <ProjectReference Include="../../src/Xapi.Lrs.PostgreSql/Xapi.Lrs.PostgreSql.csproj" />
  </ItemGroup>

</Project>
