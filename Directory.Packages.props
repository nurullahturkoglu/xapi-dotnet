<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Build-time only -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
  </ItemGroup>

  <!--
    Dependency floors of the netstandard2.0 builds: the lowest version that has every API the libraries use and no
    known vulnerability. They become the minimum versions in the nuspec, and the net481 tests run against them.
    Raise one only on purpose (CONTRIBUTING.md, "Dependency floors"); Dependabot ignores them. The net10.0 builds do
    not reference them, because the shared framework has these APIs.
  -->
  <ItemGroup>
    <!-- JsonMarshal.GetRawUtf8PropertyName is new in 10.0 -->
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
    <!-- System.Text.Json 10.0.0 depends on 10.0.0 -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
    <!-- 8.0.0 has every API used, but Microsoft.Extensions.TimeProvider.Testing needs 8.0.1 in the net481 tests -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <!-- Meter.CreateObservableUpDownCounter is new in 7.0 -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="7.0.0" />
  </ItemGroup>

  <!-- Runtime dependencies of the libraries -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only, for dotnet-ef when generating migrations (see eng/ef-migrations.sh) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <!-- Tests, samples and benchmarks -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
