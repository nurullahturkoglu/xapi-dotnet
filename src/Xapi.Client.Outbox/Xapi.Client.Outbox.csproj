<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>Library</ProjectType>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Xapi.Client.Outbox</RootNamespace>
    <Description>Durable outbox for Experience API (xAPI 2.0 and 1.0.3) statements on top of Xapi.Client: statements are stored on disk before they are sent, then delivered in order and in batches with retries, error classification, dead letters and idempotent resend. Works offline, on .NET Framework, Unity and modern .NET.</Description>
    <PackageTags>$(PackageTags);outbox;offline;retry</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Xapi.Client/Xapi.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- TimeProvider and its Delay extension; part of the framework from .NET 8 -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <!-- The hosted service exists on net10.0 only, so Unity and .NET Framework users do not get Microsoft.Extensions.* (ADR-008) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="DependencyInjection/**" />
  </ItemGroup>

</Project>
