<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>Library</ProjectType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xapi.Lrs.Sqlite</RootNamespace>
    <!-- EF Core is not trim or AOT compatible -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- XAPI0001: a provider package implements the experimental storage seams of Xapi.Lrs, and its generated migrations reference XapiLrsDbContext -->
    <NoWarn>$(NoWarn);XAPI0001</NoWarn>
    <!-- Depend on Xapi.Lrs [x.y.z]: the experimental storage types this package binds to can change in any release -->
    <XapiExactProjectReferenceVersions>true</XapiExactProjectReferenceVersions>
    <Description>SQLite storage for the Xapi.Lrs Learning Record Store: UseSqlite(connectionString), migrations, WAL mode and serialized writes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Xapi.Lrs/Xapi.Lrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <!-- eng/ef-migrations.sh sets XapiEfDesign so dotnet-ef can use this project as its startup project -->
  <PropertyGroup Condition="'$(XapiEfDesign)' == 'true'">
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup Condition="'$(XapiEfDesign)' == 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
