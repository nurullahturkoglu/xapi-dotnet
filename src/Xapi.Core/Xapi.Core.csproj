<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>Library</ProjectType>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Xapi</RootNamespace>
    <!--
      CA1000: XapiList<T>.Empty mirrors ImmutableArray<T>.Empty; the design keeps the static on the generic type.
      CA1707: XapiVersion.V1_0_3 and V2_0_0 spell the version numbers the standard uses.
      CA1710: LanguageMap and Extensions are type names defined by the xAPI standard, not generic dictionaries.
    -->
    <NoWarn>$(NoWarn);CA1000;CA1707;CA1710</NoWarn>
    <Description>Experience API (xAPI 2.0, IEEE 9274.1.1, and 1.0.3) models for .NET: strict JSON reading and writing, validation, and statement comparison. Works on .NET Framework, Unity and modern .NET.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
