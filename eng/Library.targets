<Project>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)xapi-dotnet.snk</AssemblyOriginatorKeyFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- A project that cannot be trimmed (Xapi.Lrs: EF Core) sets IsAotCompatible to false itself -->
    <IsAotCompatible Condition="'$(IsAotCompatible)' == '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(XapiPublicKey)' != ''">
    <InternalsVisibleTo Include="$(AssemblyName).Tests" Key="$(XapiPublicKey)" />
  </ItemGroup>

  <!--
    XapiExactProjectReferenceVersions=true makes the nuspec depend on the exact version of each project reference,
    [x.y.z], instead of NuGet's default minimum version. _GetProjectReferenceVersions (NuGet pack targets) collects
    those versions; the pack task reads ProjectVersion as a version range.
  -->
  <Target Name="XapiExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions" Condition="'$(XapiExactProjectReferenceVersions)' == 'true'">
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <Target Name="XapiRequireDescription" BeforeTargets="GenerateNuspec" Condition="'$(Description)' == ''">
    <Error Text="$(MSBuildProjectName) must set a Description before it can be packed." />
  </Target>

</Project>
