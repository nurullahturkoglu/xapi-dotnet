# Pinned inputs of the conformance job. Sourced by run-local.sh and appended to $GITHUB_ENV by conformance.yml.
# LRSQL_IMAGE is also read by tests/Xapi.Client.IntegrationTests and the aot-smoke job in ci.yml.
# Plain KEY=value lines only: no quotes, no spaces, no inline comments.

# adlnet/lrs-conformance-test-suite master, "Merge pull request #270" (4 Sep 2025)
CTS_REPO=https://github.com/adlnet/lrs-conformance-test-suite.git
CTS_SHA=5bc232d349c60faded8240da698f195106091638

# Node major used to generate package-lock.json and run the suite
CTS_NODE_MAJOR=22

# Reference LRS: yetanalytics/lrsql v0.9.9 (1 Oct 2026, linux/amd64 only)
LRSQL_IMAGE=yetanalytics/lrsql:v0.9.9@sha256:d0054b96ebbb41b10b371e815e326918b70f0d1788e8d24afc60af465b8f41cd

# Database for the postgres cells (multi-arch index digest)
POSTGRES_IMAGE=postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
