<Project>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)xapi-dotnet.snk</AssemblyOriginatorKeyFile>
    <!-- Test method names use underscores: Parse_rejects_unknown_property -->
    <NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <!--
    XapiExcludeFromTestRun=true keeps a test project out of `dotnet test` (see Xapi.Client.IntegrationTests). It still
    builds, and runs with `dotnet run`. dotnet test picks Microsoft.Testing.Platform projects by these two properties.
  -->
  <PropertyGroup Condition="'$(XapiExcludeFromTestRun)' == 'true'">
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- records and init in test code on the net481 target -->
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Coverage is collected from the net10.0 runs only. On .NET Framework the coverage extension would load a newer
    System.Text.Json and Microsoft.Bcl.AsyncInterfaces into the test process than the dependency floors in
    Directory.Packages.props, and the net481 tests are there to run against those floors.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
